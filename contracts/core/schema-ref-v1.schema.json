{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "schema_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Schema Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "schema_digest"
  ],
  "title": "SchemaRefV1",
  "type": "object"
}
