{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy_snapshot_id": {
      "format": "uuid",
      "title": "Policy Snapshot Id",
      "type": "string"
    },
    "policy_revision": {
      "minimum": 1,
      "title": "Policy Revision",
      "type": "integer"
    },
    "policy_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    }
  },
  "required": [
    "policy_snapshot_id",
    "policy_revision",
    "policy_digest",
    "observed_at"
  ],
  "title": "PolicySnapshotRefV1",
  "type": "object"
}
