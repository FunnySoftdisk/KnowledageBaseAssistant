{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CapabilityPlanningDescriptorV1": {
      "additionalProperties": false,
      "properties": {
        "capability_ref": {
          "$ref": "#/$defs/CapabilityRefV1"
        },
        "category": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "safe_summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Safe Summary",
          "type": "string"
        },
        "input_schema_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Input Schema Key",
          "type": "string"
        },
        "output_schema_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Output Schema Key",
          "type": "string"
        },
        "allowed_executor_kinds": {
          "items": {
            "enum": [
              "SUPERVISOR",
              "BUILT_IN",
              "EPHEMERAL"
            ],
            "type": "string"
          },
          "title": "Allowed Executor Kinds",
          "type": "array"
        }
      },
      "required": [
        "capability_ref",
        "category",
        "safe_summary",
        "input_schema_key",
        "output_schema_key",
        "allowed_executor_kinds"
      ],
      "title": "CapabilityPlanningDescriptorV1",
      "type": "object"
    },
    "CapabilityRefV1": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "capability_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Capability Version",
          "type": "string"
        },
        "integrity_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Integrity Digest",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "capability_version",
        "integrity_digest"
      ],
      "title": "CapabilityRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "capability_planning_view_v1",
      "title": "Contract Version",
      "type": "string"
    },
    "catalog_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Catalog Version",
      "type": "string"
    },
    "catalog_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalog Digest",
      "type": "string"
    },
    "descriptors": {
      "items": {
        "$ref": "#/$defs/CapabilityPlanningDescriptorV1"
      },
      "maxItems": 32,
      "title": "Descriptors",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "catalog_version",
    "catalog_digest",
    "descriptors"
  ],
  "title": "CapabilityPlanningViewV1",
  "type": "object"
}
