{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArtifactRefV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "schema_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "sha256",
        "schema_id",
        "schema_version"
      ],
      "title": "ArtifactRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding_id": {
      "format": "uuid",
      "title": "Binding Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "artifact_ref": {
      "$ref": "#/$defs/ArtifactRefV1"
    },
    "ordinal": {
      "maximum": 20,
      "minimum": 1,
      "title": "Ordinal",
      "type": "integer"
    }
  },
  "required": [
    "binding_id",
    "task_id",
    "artifact_ref",
    "ordinal"
  ],
  "title": "TaskAttachmentBindingRefV1",
  "type": "object"
}
