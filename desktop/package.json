    "build": "node build.mjs",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
