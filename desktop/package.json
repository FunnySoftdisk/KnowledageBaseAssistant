{
  "name": "knowledge-system-desktop",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Windows desktop workbench client (Electron, plain-TS renderer). DEV-07: Task event-stream reducer + fetch-SSE reconnect client + minimal task page.",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
